[Unit]
Description=AI Stock web dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/ai_stock
Environment=TZ=Asia/Seoul
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/apps/ai_stock/.venv/bin/python run_web.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
