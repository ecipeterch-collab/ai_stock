# Copy to /etc/nginx/sites-available/stock-jhunnet and symlink into sites-enabled.
# Origin cert: issue stock.jhunnet.com (or *.jhunnet.com) in Cloudflare and
# install under /etc/ssl/cloudflare/. A wildcard jhunnet.com cert can be reused
# if its SAN includes stock.jhunnet.com.

server {
    listen 80;
    listen [::]:80;
    server_name stock.jhunnet.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name stock.jhunnet.com;

    ssl_certificate /etc/ssl/cloudflare/stock.jhunnet.com.pem;
    ssl_certificate_key /etc/ssl/cloudflare/stock.jhunnet.com.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
